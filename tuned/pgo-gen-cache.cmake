set(CMAKE_BUILD_TYPE Release CACHE STRING "")
include("${CMAKE_CURRENT_LIST_DIR}/llvm-locate.cmake")
set(CMAKE_C_FLAGS "/DWIN32 /D_WINDOWS -march=znver3 -mtune=znver3 /clang:-fprofile-generate -DEGLANTINE_PGO_GENERATE" CACHE STRING "")
set(CMAKE_CXX_FLAGS "/DWIN32 /D_WINDOWS /EHsc -march=znver3 -mtune=znver3 /clang:-fprofile-generate -DEGLANTINE_PGO_GENERATE" CACHE STRING "")
file(GLOB _profile_rt "${LLVM_INSTALL_ROOT}/lib/clang/*/lib/windows/clang_rt.profile-x86_64.lib")
list(GET _profile_rt -1 _profile_rt)
set(CMAKE_EXE_LINKER_FLAGS "/machine:x64 \"${_profile_rt}\"" CACHE STRING "")
set(BUILD_TESTING OFF CACHE BOOL "")
set(YUZU_TESTS OFF CACHE BOOL "")
set(YUZU_CMD OFF CACHE BOOL "")
set(YUZU_ROOM OFF CACHE BOOL "")
set(YUZU_ROOM_STANDALONE OFF CACHE BOOL "")
set(YUZU_USE_BUNDLED_SDL3 ON CACHE BOOL "")
set(ENABLE_UPDATE_CHECKER OFF CACHE BOOL "")
set(USE_DISCORD_PRESENCE OFF CACHE BOOL "")
